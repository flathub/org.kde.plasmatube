{
    "id": "org.kde.plasmatube",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "plasmatube",
    "separate-locales": false,
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/mkspecs",
        "/share/doc",
        "/share/man",
        "/share/qlogging-categories6"
    ],
    "modules": [
        "generated/mpv.json",
        {
            "name": "yt-dlp",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-dependencies --prefix=/app *.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/7f/3d/16ea7d5638cf585991f2c5705e8083688dde633d32d0871f2404e0f4d827/yt_dlp-2026.10.26-py3-none-any.whl",
                    "sha256": "a05c5b5d8562f7e8a62f5334348b406af4930d56d3a65f8021d14af0e22339ae",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "yt-dlp",
                        "packagetype": "bdist_wheel"
                    }
                }
            ]
        },
        {
            "name": "mpvqt",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/mpvqt/mpvqt-1.2.1.tar.xz",
                    "sha256": "6ff5f56a0edd8248073446e5cc038f47d4b17c46b6af43cf438123d0ac911189",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 370634,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/mpvqt/mpvqt-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "qtkeychain",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_WITH_QT6=ON",
                "-DCMAKE_INSTALL_LIBDIR=/app/lib",
                "-DLIB_INSTALL_DIR=/app/lib",
                "-DBUILD_TRANSLATIONS=NO"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/frankosterfeld/qtkeychain/archive/0.15.0.tar.gz",
                    "sha256": "f4254dc8f0933b06d90672d683eab08ef770acd8336e44dfa030ce041dc2ca22",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 4138,
                        "stable-only": true,
                        "url-template": "https://github.com/frankosterfeld/qtkeychain/archive/$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "plasmatube",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.2/src/plasmatube-26.08.2.tar.xz",
                    "sha256": "1c950892b09098040fd03d60d13a029947d647d662d3489bfdee6f2ef30bf16e",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 328147,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/plasmatube-$version.tar.xz"
                    }
                },
                {
                    "type": "patch",
                    "path": "65a620366b1500504f9b831c539f6d68f072a420.patch"
                }
            ],
            "config-opts": [
                "-DPLASMATUBE_FLATPAK=ON"
            ]
        }
    ]
}

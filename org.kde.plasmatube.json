{
    "id": "org.kde.plasmatube",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "plasmatube",
    "separate-locales": false,
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/mkspecs",
        "/share/doc",
        "/share/man",
        "/share/qlogging-categories6"
    ],
    "modules": [
        "generated/mpv.json",
        {
            "name": "yt-dlp",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-dependencies --prefix=/app *.whl"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/30/1e/f4bf64ca733135e609696c6df77a6c22c6d4909b6e293e4563ae51ea335c/yt_dlp-2026.11.23-py3-none-any.whl",
                    "sha256": "e9188e0c559905f7ee05acc1ba0b6fb3f310e7565bf6dea5f62b5300e0775e35",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "yt-dlp",
                        "packagetype": "bdist_wheel"
                    }
                }
            ]
        },
        {
            "name": "mpvqt",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/mpvqt/mpvqt-1.2.1.tar.xz",
                    "sha256": "6ff5f56a0edd8248073446e5cc038f47d4b17c46b6af43cf438123d0ac911189",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 370634,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/mpvqt/mpvqt-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "qtkeychain",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_WITH_QT6=ON",
                "-DCMAKE_INSTALL_LIBDIR=/app/lib",
                "-DLIB_INSTALL_DIR=/app/lib",
                "-DBUILD_TRANSLATIONS=NO"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/frankosterfeld/qtkeychain/archive/0.15.0.tar.gz",
                    "sha256": "f4254dc8f0933b06d90672d683eab08ef770acd8336e44dfa030ce041dc2ca22",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 4138,
                        "stable-only": true,
                        "url-template": "https://github.com/frankosterfeld/qtkeychain/archive/$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "plasmatube",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/plasmatube-26.08.3.tar.xz",
                    "sha256": "7f36fbccca378f59c38d3a2e8aa22ae017222693efe0c19cb19f994e50089ae9",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 328147,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/plasmatube-$version.tar.xz"
                    }
                }
            ],
            "config-opts": [
                "-DPLASMATUBE_FLATPAK=ON"
            ]
        }
    ]
}
